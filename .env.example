# CloudNotes — example environment configuration.
# Copy to `.env` and adjust values. NEVER commit your real `.env` file.
# Every variable maps to a field in app/core/config.py (CLOUDNOTES_ prefix).

# Runtime environment name (local | development | staging | production)
CLOUDNOTES_APP_ENV=local

# Enable FastAPI debug mode (never enable in production)
CLOUDNOTES_DEBUG=false

# Root log level (DEBUG | INFO | WARNING | ERROR)
CLOUDNOTES_LOG_LEVEL=INFO

# Human-readable application name used in OpenAPI docs
CLOUDNOTES_APP_NAME=CloudNotes

# --- Database (PostgreSQL) ---
# Async SQLAlchemy URL used by the application and Alembic (asyncpg driver).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
CLOUDNOTES_DATABASE_URL=postgresql+asyncpg://cloudnotes:cloudnotes@localhost:5432/cloudnotes
#
# Integration tests (optional). When set, `pytest -m db` runs against this
# database; the test suite creates and drops its own schema. Leave unset to
# skip database integration tests.
# CLOUDNOTES_TEST_DATABASE_URL=postgresql+asyncpg://cloudnotes:cloudnotes@localhost:5432/cloudnotes_test
